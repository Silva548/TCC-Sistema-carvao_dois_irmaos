<h1>Editar produto</h1>

<% if (erro) { %>
    <div class="alert alert-danger"><%= erro %></div>
<% } %>

<form action="/produtos/<%= produto.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
    <%- include('../partials/csrf') %>
    <div class="form-group">
        <label for="nome">Nome</label>
        <input type="text" class="form-control" id="nome" name="nome" value="<%= submetido && submetido.nome ? submetido.nome : (produto.nome || '') %>" maxlength="255" required>
    </div>
    <div class="form-group">
        <label for="descricao">Descrição</label>
        <textarea id="descricao" class="form-control" name="descricao"><%= submetido && submetido.descricao !== undefined ? submetido.descricao : (produto.descricao || '') %></textarea>
    </div>
    <div class="form-group">
        <label for="embalagem">Embalagem</label>
        <% const embalagemAtual = submetido && submetido.embalagem !== undefined ? String(submetido.embalagem) : String(produto.embalagem || ''); %>
        <select class="form-control" id="embalagem" name="embalagem" required>
            <option value="premium" <%= embalagemAtual === 'premium' ? 'selected' : '' %>>Premium</option>
            <option value="basica" <%= embalagemAtual === 'basica' ? 'selected' : '' %>>Básica</option>
        </select>
    </div>
    <div class="form-row">
        <div class="form-group col-md-6">
            <label for="preco_entrega">Preço de entrega (R$)</label>
            <input type="number" step="0.01" min="0.01" class="form-control" id="preco_entrega" name="preco_entrega" value="<%= submetido && submetido.preco_entrega ? submetido.preco_entrega : produto.preco_entrega %>" required>
        </div>
        <div class="form-group col-md-6">
            <label for="preco_retirada">Preço de retirada (R$)</label>
            <input type="number" step="0.01" min="0.01" class="form-control" id="preco_retirada" name="preco_retirada" value="<%= submetido && submetido.preco_retirada ? submetido.preco_retirada : produto.preco_retirada %>" required>
        </div>
    </div>
    <div class="form-group">
        <label for="peso_kg">Peso (kg)</label>
        <input type="number" step="0.01" min="0.01" class="form-control" id="peso_kg" name="peso_kg" value="<%= submetido && submetido.peso_kg ? submetido.peso_kg : produto.peso_kg %>" required>
    </div>
    <div class="form-group">
        <label for="estoque">Estoque</label>
        <input type="number" min="0" step="1" class="form-control" id="estoque" name="estoque" value="<%= submetido && submetido.estoque !== undefined ? submetido.estoque : produto.estoque %>" required>
    </div>
    <div class="form-group">
        <label for="categoria_id">Categoria</label>
        <select class="form-control" id="categoria_id" name="categoria_id">
            <%
                const categoriaAtual = submetido && submetido.categoria_id !== undefined
                    ? String(submetido.categoria_id)
                    : String(produto.categoria_id || '');
            %>
            <option value="">Sem categoria</option>
            <% categorias.forEach(categoria => { %>
                <option value="<%= categoria.id %>" <%= categoriaAtual === String(categoria.id) ? 'selected' : '' %>><%= categoria.nome %></option>
            <% }) %>
        </select>
    </div>
    <div class="form-group">
        <label for="imagem">Imagem do produto</label>
        <% if (produto.imagem) { %>
            <div class="mb-2">
                <img src="<%= produto.imagem %>" alt="Imagem atual de <%= produto.nome %>" class="produto-img" style="width: 220px; height: auto;">
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="remover_imagem" name="remover_imagem" value="1">
                <label class="form-check-label" for="remover_imagem">Remover a imagem atual</label>
            </div>
        <% } %>
        <input type="file" class="form-control-file" id="imagem" name="imagem" accept="image/jpeg,image/png,image/webp">
        <small class="form-text text-muted">Opcional. JPG, PNG ou WEBP, até 2 MB. Enviar um arquivo substitui a foto atual.</small>
    </div>
    <button type="submit" class="btn btn-warning">Salvar</button>
</form>
