<%# Carrinho do cliente comum (botão flutuante + modal + config do JS).

    Extraído de index.ejs porque duas telas precisam dele agora: o catálogo da
    home e a ficha do produto. public/js/carrinho.js funciona nas duas — ele se
    ancora no #carrinho-config e só age se o encontrar.

    Não incluir para admin nem para visitante: o bloco #carrinho-config é o que
    habilita o script, e sem carrinho não há o que mostrar. %>
<button type="button" class="btn btn-primary carrinho-flutuante" id="abrir-carrinho"
    data-toggle="modal" data-target="#modal-carrinho">
    <svg class="icone-carrinho" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45C4.52 15.37 5.48 17 6.5 17H19v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03L20.88 5H5.21l-.94-2H1zm16 16V6h2v12h-2z"/>
    </svg>
    Carrinho <span class="carrinho-contador" id="carrinho-contador">0</span>
</button>

<div class="modal fade" id="modal-carrinho" tabindex="-1" role="dialog" aria-labelledby="titulo-carrinho" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo-carrinho">Seu carrinho</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="carrinho-vazio" class="alert alert-info d-none">Seu carrinho está vazio.</div>
                <div id="carrinho-lista"></div>

                <div class="form-row mt-3">
                    <div class="form-group col-md-6">
                        <label for="carrinho-pagamento">Forma de pagamento</label>
                        <select class="form-control" id="carrinho-pagamento">
                            <option value="">Selecione</option>
                            <% formasPagamento.forEach(forma => { %>
                                <option value="<%= forma %>"><%= formatadores.rotuloPagamento(forma) %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label for="carrinho-entrega">Entrega ou retirada</label>
                        <select class="form-control" id="carrinho-entrega">
                            <% tiposEntrega.forEach(tipo => { %>
                                <option value="<%= tipo %>"><%= formatadores.rotuloTipoEntrega(tipo) %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>


                <%# Endereco de entrega. A secao nasce escondida e e o
                    carrinho.js que mostra quando a modalidade e 'entrega' —
                    mostrar sempre faria o cliente preencher a rua mesmo em
                    pedido de retirada, que nao tem endereco. %>
                <div id="carrinho-endereco" class="mt-3 d-none">
                    <h3 class="h6">Endereco de entrega</h3>
                    <div class="form-row">
                        <div class="form-group col-md-3">
                            <label for="carrinho-cep">CEP</label>
                            <input type="text" class="form-control" id="carrinho-cep"
                                inputmode="numeric" maxlength="9" placeholder="00000-000">
                        </div>
                        <div class="form-group col-md-6">
                            <label for="carrinho-logradouro">Logradouro</label>
                            <input type="text" class="form-control" id="carrinho-logradouro"
                                maxlength="255">
                        </div>
                        <div class="form-group col-md-3">
                            <label for="carrinho-numero">Numero</label>
                            <input type="text" class="form-control" id="carrinho-numero"
                                maxlength="20">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="carrinho-complemento">Complemento</label>
                            <input type="text" class="form-control" id="carrinho-complemento"
                                maxlength="255" placeholder="Apto, bloco, sala">
                        </div>
                        <div class="form-group col-md-4">
                            <label for="carrinho-bairro">Bairro</label>
                            <input type="text" class="form-control" id="carrinho-bairro"
                                maxlength="120">
                        </div>
                        <div class="form-group col-md-3">
                            <label for="carrinho-cidade">Cidade</label>
                            <input type="text" class="form-control" id="carrinho-cidade"
                                maxlength="120">
                        </div>
                        <div class="form-group col-md-1">
                            <label for="carrinho-uf">UF</label>
                            <input type="text" class="form-control text-uppercase" id="carrinho-uf"
                                maxlength="2">
                        </div>
                    </div>
                </div>

                <h3 class="h6 mt-3">Contato para o pedido</h3>
                <div class="form-row">
                    <div class="form-group col-md-5">
                        <label for="carrinho-contato-nome">Nome</label>
                        <input type="text" class="form-control" id="carrinho-contato-nome"
                            maxlength="255" value="<%= valorContato('nome') %>">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="carrinho-contato-email">E-mail</label>
                        <input type="email" class="form-control" id="carrinho-contato-email"
                            maxlength="255" value="<%= valorContato('email') %>">
                    </div>
                    <div class="form-group col-md-3">
                        <label for="carrinho-contato-telefone">WhatsApp</label>
                        <input type="tel" class="form-control" id="carrinho-contato-telefone"
                            maxlength="20" value="<%= valorContato('telefone') %>">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div id="carrinho-erro" class="alert alert-danger w-100 d-none mb-2"></div>
                <div class="mr-auto carrinho-total" id="carrinho-total">Total: R$ 0,00</div>
                <button type="button" class="btn btn-link" data-dismiss="modal">Continuar comprando</button>
                <button type="button" class="btn btn-success" id="finalizar-pedido">Finalizar pedido</button>
            </div>
        </div>
    </div>
</div>

<%# Config para public/js/carrinho.js. Sem este bloco (admin/visitante) o
    script não é carregado. O preço é recalculado no servidor: aqui é só
    exibição. %>
<div id="carrinho-config"
    data-csrf="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
    data-criar-pedido="/pedidos?format=json"
    data-contato-nome="<%= valorContato('nome') %>"
    data-contato-email="<%= valorContato('email') %>"
    data-contato-telefone="<%= valorContato('telefone') %>"
    hidden></div>