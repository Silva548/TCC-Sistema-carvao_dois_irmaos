<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand" href="/">
        <img src="<%= empresa.logo %>" alt="Logomarca <%= empresa.nome %>" class="logo logo-navbar" width="40" height="40">
        <span class="navbar-brand-texto"><%= empresa.nomeCurto %></span>
    </a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
        <% if (!currentUser) { %>
            <%# Visitante anônimo: sem esta sessão só existem login e cadastro.
                Link de carrinho aqui não teria para onde levar — o carrinho
                exige sessão (app.js monta /catalogo com requireAuth). %>
            <ul class="navbar-nav ml-auto">
                <%# Endereço e horário ficam acessíveis a quem ainda não tem
                    conta: é o que o visitante precisa antes de decidir. %>
                <li class="nav-item">
                    <a class="nav-link" href="/onde-estamos">Onde estamos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/registrar">Criar conta</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/login">Entrar</a>
                </li>
            </ul>
        <% } else { %>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>

                <%# Cadastros são só do admin. O usuário comum vê apenas Pedidos —
                    esconder aqui é cortesia visual; o servidor recusa a rota de
                    qualquer forma (app.js), então ocultar não é a segurança. %>
                <% if (currentUser.role === 'admin') { %>
                    <!-- Dropdown Clientes -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownClientes" role="button"
                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Clientes
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownClientes">
                            <a class="dropdown-item" href="/clientes/new">Cadastrar Cliente</a>
                            <a class="dropdown-item" href="/clientes">Listar Clientes</a>
                        </div>
                    </li>

                    <!-- Dropdown Produtos -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownProdutos" role="button"
                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Produtos
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownProdutos">
                            <a class="dropdown-item" href="/produtos/new">Cadastrar Produto</a>
                            <a class="dropdown-item" href="/produtos">Listar Produtos</a>
                        </div>
                    </li>

                    <!-- Dropdown Categorias -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownCategorias" role="button"
                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Categorias
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownCategorias">
                            <a class="dropdown-item" href="/categorias/new">Cadastrar Categoria</a>
                            <a class="dropdown-item" href="/categorias">Listar Categorias</a>
                        </div>
                    </li>
                <% } %>

                <!-- Pedidos -->
                <li class="nav-item">
                    <a class="nav-link" href="/pedidos">Pedidos</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/onde-estamos">Onde estamos</a>
                </li>

                <% if (currentUser.role !== 'admin') { %>
                    <!-- Dados de contato do cliente: nome, e-mail e WhatsApp que
                        acompanham o pedido enviado -->
                    <li class="nav-item">
                        <a class="nav-link" href="/meus-dados">Meus dados</a>
                    </li>
                <% } %>

                <% if (currentUser.role === 'admin') { %>
                    <!-- Dropdown Usuários -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownUsers" role="button"
                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Usuários
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownUsers">
                            <a class="dropdown-item" href="/users/new">Cadastrar Usuário</a>
                            <a class="dropdown-item" href="/users">Listar Usuários</a>
                        </div>
                    </li>
                <% } %>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <span class="navbar-text mr-3"><%= currentUser.username %> (<%= currentUser.role %>)</span>
                </li>
                <li class="nav-item">
                    <form action="/logout" method="POST" style="display: inline;">
                        <%- include('csrf') %>
                        <button type="submit" class="btn btn-outline-danger btn-sm mt-1">Sair</button>
                    </form>
                </li>
            </ul>
        <% } %>
    </div>
</nav>
